# A generated secret for Payload — generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here

# Database — local Docker MongoDB by default (docker compose up -d)
DATABASE_URI=mongodb://admin:password123@localhost:27017/mcreative_db?authSource=admin

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload email (dev falls back to an Ethereal test inbox if these are empty)
EMAIL_FROM_NAME=M Creative
EMAIL_FROM_ADDRESS=no-reply@mcreative.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
