{
  "name": "mcreative",
  "version": "1.0.0",
  "description": "M Creative — marketing site on Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "dotenv -e .env -- cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rimraf .next && dotenv -e .env -- cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "dotenv -e .env -- cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.62.1",
    "@payloadcms/email-nodemailer": "3.62.1",
    "@payloadcms/next": "3.62.1",
    "@payloadcms/richtext-lexical": "3.62.1",
    "@payloadcms/ui": "3.62.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^11.15.0",
    "graphql": "^16.8.1",
    "next": "15.5.25",
    "payload": "3.62.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.5.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.25",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
